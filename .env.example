# ============================================
# RocketBase Production Environment Variables
# ============================================
# Copy this file to .env and update the values
# Do not commit .env to version control

# ============================================
# Container Registry Configuration
# ============================================
REGISTRY=ghcr.io/vski-ai/sdk
VERSION=v1.0.2

# ============================================
# API Configuration
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_NAME=postgres

# ============================================
# Redis/Valkey Configuration
# ============================================
REDIS_HOST=db
REDIS_PORT=6379

# ============================================
# Security Configuration
# ============================================
# JWT secret used for token signing
# Generate a strong random string (min 32 characters)
JWT_SECRET=CHANGE_ME_TO_SUPER_SECRET_KEY_AT_LEAST_32_CHARS_LONG

# ============================================
# Retention Service Configuration
# ============================================
# Interval for retention policy checks in milliseconds (default: 30 minutes)
RETENTION_INTERVAL_MS=1800000

# ============================================
# S3 Storage Configuration (Optional)
# ============================================
# Set to true to enable S3 storage instead of local filesystem
S3_ENABLED=false

# S3 bucket name
S3_BUCKET=

# S3 region (e.g., us-east-1, eu-west-1)
S3_REGION=us-east-1

# Custom S3 endpoint (for S3-compatible services like MinIO)
S3_ENDPOINT=

# S3 access key ID
S3_ACCESS_KEY=

# S3 secret access key
S3_SECRET=

# Force path-style URLs (required for MinIO and some S3-compatible services)
S3_FORCE_PATH_STYLE=false

# ============================================
# Security Best Practices
# ============================================
# 1. Generate strong passwords using:
#    openssl rand -base64 32
#
# 2. Never commit .env files to version control
#
# 3. Rotate secrets regularly
#
# 4. Use different secrets for development, staging, and production
#
# 5. Store secrets in a secure secret management system
#    (e.g., AWS Secrets Manager, HashiCorp Vault, Docker Secrets)
